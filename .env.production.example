# =============================================================================
# Avecinna Production Environment Configuration (Dokploy)
# =============================================================================

# Primary PostgreSQL Database (Operational Clinical Data)
PRIMARY_DB_NAME=avecinna_primary_db
PRIMARY_DB_USER=postgres
PRIMARY_DB_PASSWORD=change_this_to_a_strong_primary_password_123!

# Isolated Audit PostgreSQL Database (Cryptographic Append-Only Ledger)
AUDIT_DB_NAME=avecinna_audit_db
AUDIT_DB_USER=audit_admin
AUDIT_DB_PASSWORD=change_this_to_a_strong_audit_password_456!

# Fastify Authentication Secret (Min 32 characters, recommended 64-char hex)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key_here

# Initial Database Seeding (Set to 'true' on initial deploy to create wards & default users)
SEED_DATABASE=true

# Frontend Public API Base URL (Must be the public HTTPS URL accessed by users' browsers)
NUXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
